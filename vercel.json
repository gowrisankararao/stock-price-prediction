{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "JWT_SECRET": "@jwt_secret",
    "API_KEY": "@api_key",
    "HUGGINGFACE_API_KEY": "@huggingface_api_key"
  }
}
