<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chatbot</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
</head>
<body class="flex flex-col items-center min-h-screen p-5">

    <!-- Navbar -->
   <!-- Navbar -->
<nav class="fixed top-0 left-0 w-full p-2 bg-black bg-opacity-40 shadow-lg z-50">
    <div class="flex items-center justify-between mx-auto max-w-7xl">
        <div class="flex items-center text-2xl font-semibold">
            <img src="https://static.vecteezy.com/system/resources/thumbnails/016/227/291/small/bull-with-chart-bar-logo-design-finance-logo-design-free-vector.jpg" 
                 alt="Stock Market Logo" 
                 class="h-12 rounded-lg">
        </div>
        <div class="flex space-x-6">
            <a href="/home" class="hover:text-yellow-400">🏠 Home</a>
            <a href="/admin" class="hover:text-yellow-400">🔧 Admin</a>
            <a href="/about" class="hover:text-yellow-400">ℹ️ About</a>
            <a href="/predict" class="hover:text-yellow-400">📈 Get Insights</a>
          
            <a href="/logout" class="hover:text-yellow-400">🚪 Logout</a>
        </div>
    </div>
</nav>

<body class="flex items-center justify-center h-screen bg-gradient-to-br from-blue-200 to-indigo-300" 
    style="background-image: url(https://img.freepik.com/free-vector/gradient-abstract-wireframe-background_23-2149020364.jpg); background-repeat: no-repeat; background-size: cover;">
    <style>
         body {
            background: linear-gradient(135deg, #0f172a, #1e3a8a);
            color: white;
        }

        </style>
    
   <!-- Chatbot Avatar -->
<img src="https://cdn-icons-png.flaticon.com/512/4712/4712033.png" 
alt="Chatbot Avatar"
class="absolute top-[100px] left-5 w-16 h-16 rounded-full border-4 border-white shadow-lg animate-pulse">

       
<img src="data:image/png;base64," 
alt="Chatbot Illustration"
class="absolute right-10 top-[2in] transform w-96 h-auto rounded-lg shadow-xl">


  <!-- Chatbot Container moved 1 inch down -->
<div class="p-10 w-[600px] h-[600px] rounded-2xl backdrop-blur-xl bg-white/20 border border-gray-300/30 shadow-2xl mt-[0.43in]">
    <h2 class="mb-6 text-3xl font-bold text-white text-center tracking-wide">💬 Chatbot</h2>

       <!-- Chat Display Box moved 1 inch down -->
<div id="chatbox" class="h-96 max-h-[500px] p-6 mb-6 mt-[0.3in] overflow-y-auto border border-gray-300/30 rounded-lg bg-white/30 shadow-inner text-white">
    <% if (botResponse) { %>
        <p class="text-white"><strong>Bot:</strong> <%= botResponse %></p>
    <% } else { %>
        <p class="italic text-gray-300">Bot is waiting for your message...</p>
    <% } %>
</div>



    <!-- Chat Input Form moved 1 inch down -->
<form action="/message" method="POST" class="flex gap-2 mt-[0.5in]">
    <input type="text" name="message" id="message" placeholder="Type your message..." required
        class="w-full px-4 py-2 border border-gray-300/30 rounded-lg bg-white/30 focus:outline-none focus:ring-2 focus:ring-blue-400 shadow-sm placeholder-gray-400 text-gray-100 transition-all">
    
    <button type="submit" id="sendButton"
        class="px-5 py-2 text-white bg-blue-600 rounded-lg transition hover:bg-blue-700 hover:ring-2 hover:ring-blue-300 shadow-md transform hover:scale-105">
        ➤
    </button>
</form>


<!-- Chatbot Illustration on the Right Side -->
    <script>
        document.querySelector("#sendButton").addEventListener("click", function() {
            setTimeout(() => {
                document.querySelector("#chatbox").scrollTop = document.querySelector("#chatbox").scrollHeight;
            }, 100);
        });
    </script>
</body>
</html>
