      .ticker-content {
    display: inline-block;
    padding-left: 100%;
    animation: tickerMove 15s linear infinite;
}
        
        @keyframes tickerMove {
    from { transform: translateX(0%); }  /* Change from 100% to 0% */
    to { transform: translateX(-100%); }
}
        
.logo-container {
    position: fixed;
    right: 200px; /* Increased distance from the right */
