<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📈 Stock Predictor</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            background: url('https://static.vecteezy.com/system/resources/previews/004/940/875/original/artificial-intelligence-machine-learning-ai-data-deep-learning-for-future-technology-artwork-mining-isometric-neural-network-machine-programming-and-responsive-web-banner-illustration-vector.jpg') no-repeat center center fixed;
            background-size: cover;
            color: white;
        }
        
    </style>
</head>

<!-- Chatbot Illustration on the Right Side -->
<img src="data:image/png;base64," 
    alt="Chatbot Illustration"
    class="absolute right-10 top-[calc(50%+192px)] transform -translate-y-1/2 w-[400px] h-auto rounded-lg shadow-xl"



    
   <!-- Navbar -->
   <nav class="w-full p-4 navbar">
    <div class="flex items-center justify-between mx-auto max-w-7xl">
        <div class="flex items-center text-2xl font-semibold">
            <img src="https://static.vecteezy.com/system/resources/thumbnails/016/227/291/small/bull-with-chart-bar-logo-design-finance-logo-design-free-vector.jpg" alt="Stock Market Logo" class="h-12 rounded-lg">
        </div>
        <div class="flex space-x-6">
            <a href="/home" class="hover:text-yellow-400">🏠 Home</a>
            <a href="/admin" class="hover:text-yellow-400">🔧 Admin</a>
            <a href="/about" class="hover:text-yellow-400"> ℹ️About</a>
            <a href="/predict" class="hover:text-yellow-400">📈Get Insights</a>
            <a href="/message" class="hover:text-yellow-400">💬 Chat with AI</a>
            <a href="/logout" class="hover:text-yellow-400">🚪 Logout</a>
        </div>
    </div>
</nav>


    
    <div class="h-screen flex flex-col items-center justify-start pt-16 relative">
        <!-- Big Heading with Animation - Centered -->
        <h1 class="text-4xl font-bold text-white mb-2 text-center animate-fade-in-down">
            📈 Stock Price Prediction
        </h1>
          <!-- Definition with Animation - Centered Below Navbar -->
<div class="text-center mt-2 animate-fade-in">
    <p class="text-lg text-gray-300 mb-6 max-w-2xl mx-auto">
        Stock price prediction uses historical data and machine learning to forecast future stock movements, helping investors make informed decisions.
    </p>
</div>
    </div>
    
      <div class="stock-container mt-70"> <!-- Increased margin from the top -->
            <!-- Stock Input Box -->
            <div class="p-6 bg-white bg-opacity-20 backdrop-blur-lg rounded-xl shadow-xl text-center w-96 animate-fade-in-up">
                <h2 class="mb-8 text-2xl font-semibold text-black">🔍 Enter Stock Symbol</h2>
                <input id="stockSymbol" class="w-full p-3 rounded-lg text-black border border-black focus:ring-2 focus:ring-yellow-400 focus:outline-none" type="text" placeholder="e.g., AAPL" />
                <button onclick="fetchStockData()" class="mt-4 w-full bg-yellow-400 text-gray-900 py-2 rounded-lg font-bold hover:bg-yellow-500">Get Stock Data</button>
                <div id="stockData" class="mt-4 text-lg text-black"></div>
            </div>
        </div>
        
        
    
    <!-- Tailwind Animations -->
    <style>
        .stock-container {
    position: absolute;
    top: 20px; /* Adjust the value to your preference */
    left: 50%;
    transform: translateX(-50%);
  }
    @keyframes fade-in-down {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fade-in-up {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fade-in-right {
        from { opacity: 0; transform: translateX(20px); }
        to { opacity: 1; transform: translateX(0); }
    }
    @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    
    .animate-fade-in-down { animation: fade-in-down 1s ease-out; }
    .animate-fade-in-up { animation: fade-in-up 1s ease-out; }
    .animate-fade-in-right { animation: fade-in-right 1s ease-out; }
    .animate-fade-in { animation: fade-in 1.5s ease-out; }
    </style>
    
    <style>
        .ticker {
          overflow: hidden;
          white-space: nowrap;
          position: absolute;
          top: 70px; /* Adjust position as needed */
          left: 0;
          width: 100%;
        }
      
        .ticker-content {
          display: inline-block;
          padding-left: 100%;
          animation: ticker-scroll 20s linear infinite;
        }
      
        @keyframes ticker-scroll {
          from {
            transform: translateX(100%);
          }
          to {
            transform: translateX(-100%);
          }
        }
      </style>
      
      <style>
        #chartContainer {
            position: relative;
            top: -150px; /* Adjust this value as needed */
        }
    </style>
    
    
      <div id="chartContainer" class="mt-5 w-3/4 mx-auto p-6 bg-white shadow-lg rounded-lg border border-gray-200 hidden">
    <h2 class="text-2xl font-semibold text-white-800 text-center mb-4">📊 Stock Price Chart</h2>
    
    <!-- Buttons for selecting time frame -->
    <div class="flex justify-center gap-4 mb-4">
        <button onclick="updateChart('1week')" class="px-4 py-2 bg-green-500 text-white rounded-lg">1 Week</button>
        <button onclick="updateChart('1month')" class="px-4 py-2 bg-yellow-500 text-white rounded-lg">1 Month</button>
    </div>

    <!-- Dropdown for selecting chart type -->
    <div class="flex justify-center gap-4 mb-4">
        <label for="chartType" class="text-white-700 font-semibold">Select Chart Type:</label>
        <select id="chartType" onchange="updateChart(currentTimeframe)" class="px-4 py-2 border rounded-lg">
            <option class="bg-black" value="line">📈 Line Chart</option>
            <option class="bg-black" value="bar">📊 Bar Chart</option>
           
        </select>
    </div>

    <div class="w-full h-[400px]">
        <canvas id="stockChart"></canvas>
    </div>
</div>

<script>
    let stockChart, timeSeriesData, currentTimeframe = '1week';

    async function fetchStockData() {
        const symbol = document.getElementById('stockSymbol').value.trim();
        if (!symbol) return alert('Please enter a stock symbol.');

        try {
            const response = await fetch(`/api/stock/${symbol}`);
            const data = await response.json();
            const stockContainer = document.getElementById('stockData');

            if (!data || !data['Time Series (Daily)']) {
                stockContainer.innerHTML = '<p class="text-red-500">❌ No data available.</p>';
                if (stockChart) stockChart.destroy();
                return;
            }

            timeSeriesData = data['Time Series (Daily)'];
            document.getElementById('chartContainer').classList.remove('hidden');
            updateChart(currentTimeframe);
        } catch (error) {
            alert('⚠️ Error fetching stock data');
        }
    }

    function updateChart(timeframe) {
        currentTimeframe = timeframe; // Store the selected timeframe
        const timeframes = { '1day': 1, '1week': 7, '1month': 30 };
        const labels = Object.keys(timeSeriesData).slice(0, timeframes[timeframe]).reverse();
        const prices = labels.map(date => parseFloat(timeSeriesData[date]['1. open']));
        renderStockChart(labels, prices);
    }

    function renderStockChart(labels, data) {
    const ctx = document.getElementById('stockChart').getContext('2d');
    if (stockChart) stockChart.destroy();

    const chartType = document.getElementById('chartType').value; // Get selected chart type
    stockChart = new Chart(ctx, {
        type: chartType,
        data: {
            labels: labels,
            datasets: [{
                label: `📊 Stock Prices`,
                data: data,
                borderColor: 'rgba(255, 193, 7, 1)',  // Line color
                backgroundColor: 'rgba(255, 193, 7, 0.4)',  // Light yellow background for bars/lines
                tension: 0.4,
                borderWidth: 3,
                pointRadius: 4,
                pointBackgroundColor: 'rgba(255, 193, 7, 1)'
            }]
        },
        options: {
            responsive: true,
            scales: {
                x: { 
                    title: { display: true, text: 'Date', color: 'white' },
                    ticks: { color: 'white' }
                },
                y: { 
                    title: { display: true, text: 'Price (USD)', color: 'white' },
                    ticks: { color: 'white' }
                }
            },
            plugins: {
                legend: { labels: { color: 'white' } }
            }
        }
    });

    // Set the chart's background color
    document.getElementById('chartContainer').style.backgroundColor = 'rgba(0, 0, 0, 0.7)'; // Dark background for contrast
}

</script>

</body>
</html>