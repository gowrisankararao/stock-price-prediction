<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📈 Stock Predictor - About</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script src="https://unpkg.com/@tailwindcss/browser@4"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    
    <style>
        body {
            background: linear-gradient(135deg, #1e293b, #0f172a);
            color: white;
            font-family: 'Poppins', sans-serif;
        }
        .navbar a {
    position: relative;
    padding-bottom: 5px;
}
.navbar a::after {
    content: "";
    position: absolute;
    width: 0;
    height: 2px;
    background: yellow;
    left: 50%;
    bottom: 0;
    transition: all 0.3s ease-in-out;
    transform: translateX(-50%);
}
.navbar a:hover::after {
    width: 100%;
}

        
        .fade-in {
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.6s ease-in-out;
        }
        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }
        .card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    transition: transform 0.3s, box-shadow 0.3s;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
}
.card:hover {
    transform: translateY(-8px);
    box-shadow: 0px 6px 15px rgba(12, 231, 243, 0.5);
}
.bg-glass {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(15px);
    border-radius: 10px;
    padding: 20px;
    box-shadow: 0px 6px 20px rgba(255, 255, 255, 0.1);
}


    </style>
</head>
<body>
    <nav class="navbar w-full p-4 shadow-lg fixed top-0 left-0 right-0 z-50">
        <div class="flex items-center justify-between mx-auto max-w-7xl">
            <span class="text-yellow-400 text-2xl font-semibold">📈 Stock Predictor</span>
            <div class="flex space-x-6">
                <a href="/home" class="hover:text-yellow-400">🏠 Home</a>
                <a href="/admin" class="hover:text-yellow-400">🔧 Admin</a>
                <a href="/about" class="hover:text-yellow-400">ℹ️About</a>
                <a href="/logout" class="hover:text-yellow-400">🚪 Logout</a>
                <a href="/message" class="bg-gradient-to-r from-yellow-400 to-orange-500 px-5 py-2 rounded-full text-black font-semibold shadow-lg hover:shadow-xl transition-all duration-300">
                    💬 Chat with AI
                </a>
                
            </div>
        </div>
    </nav>
    
    <div class="container mx-auto p-6 pt-24">
        <h1 class="text-4xl font-bold text-yellow-400 text-center fade-in">About Stock Predictor</h1>
        <p class="text-center mt-4 text-lg fade-in">An advanced tool to track and predict stock prices in real-time.</p>
        
        <div class="mt-8 fade-in">
            <h2 class="text-3xl font-semibold text-yellow-300">Technologies Used</h2>
            <ul class="list-disc list-inside mt-2">
                <% technologies.forEach(tech => { %>
                    <li class="text-lg">🔹 <%= tech %></li>
                <% }); %>
            </ul>
        </div>
      

        <div class="grid grid-cols-2 gap-6 mt-8">
            <div class="card p-6 rounded-lg fade-in">
                <h3 class="text-2xl font-semibold text-green-400">Advantages of Stock Trading</h3>
                <ul class="list-disc list-inside mt-2">
                    <% advantages.forEach(adv => { %>
                        <li class="text-lg">✅ <%= adv %></li>
                    <% }); %>
                </ul>
            </div>
            <div class="card p-6 rounded-lg fade-in">
                <h3 class="text-2xl font-semibold text-red-400">Disadvantages of Stock Trading</h3>
                <ul class="list-disc list-inside mt-2">
                    <% disadvantages.forEach(disadv => { %>
                        <li class="text-lg">⚠️ <%= disadv %></li>
                    <% }); %>
                </ul>
            </div>
        </div>
    </div>
    <div class="card p-6 rounded-lg fade-in" data-aos="fade-up">
                      <div class="grid grid-cols-2 gap-6 mt-8">
            <div class="bg-blue-800 p-4 rounded-lg">
                <h3 class="text-2xl font-semibold text-blue-400">Fresher Should Do</h3>
                <ul class="list-disc list-inside mt-2">
                    <% fresherDos.forEach(doItem => { %>
                        <li class="text-lg">✅ <%= doItem %></li>
                    <% }); %>
                </ul>
            </div>
            <div class="bg-red-800 p-4 rounded-lg">
                <h3 class="text-2xl font-semibold text-red-400">Fresher Should Avoid</h3>
                <ul class="list-disc list-inside mt-2">
                    <% fresherDonts.forEach(dontItem => { %>
                        <li class="text-lg">❌ <%= dontItem %></li>
                    <% }); %>
                </ul>
            </div>
        </div>
    </div>
    
    <footer class="bg-black bg-opacity-80 text-gray-300 p-6 mt-10">
        <div class="max-w-6xl mx-auto flex flex-wrap justify-between">
            <div class="w-full md:w-1/3 mb-6 md:mb-0">
                <h2 class="text-xl font-semibold text-yellow-400">Stock Predictor</h2>
                <p class="mt-2 text-sm">Empowering traders with AI-driven stock market insights and predictions.</p>
            </div>
            <div class="w-full md:w-1/3 mb-6 md:mb-0">
                <h2 class="text-lg font-semibold text-yellow-400">Quick Links</h2>
                <ul class="mt-2 text-sm space-y-1">
                    <li><a href="/home" class="hover:text-yellow-400">Home</a></li>
                    <li><a href="/about" class="hover:text-yellow-400">About</a></li>
                    <li><a href="/dashboard" class="hover:text-yellow-400">Dashboard</a></li>
                    <li><a href="/contact" class="hover:text-yellow-400">Contact</a></li>
                </ul>
            </div>
            <div class="w-full md:w-1/3">
                <h2 class="text-lg font-semibold text-yellow-400">Contact Us</h2>
                <p class="mt-2 text-sm">Email: support@stockpredictor.com</p>
                <p class="text-sm">Phone: +1 234 567 890</p>
            </div>
        </div>
        <div class="text-center mt-6">
            <h2 class="text-lg font-semibold text-yellow-400">Follow Us</h2>
            <div class="flex justify-center space-x-4 mt-2">
                <a href="https://linkedin.com" target="_blank"><i class="fab fa-linkedin text-xl hover:text-blue-400"></i></a>
                <a href="https://instagram.com" target="_blank"><i class="fab fa-instagram text-xl hover:text-pink-400"></i></a>
                <a href="https://github.com" target="_blank"><i class="fab fa-github text-xl hover:text-gray-400"></i></a>
            </div>
        </div>
        <div class="text-center mt-4 text-sm text-gray-400">
            <p>&copy; 2025 Stock Predictor. All rights reserved.</p>
        </div>
    </footer>
    
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll(".fade-in").forEach(element => {
                element.classList.add("visible");
            });
        });
        document.addEventListener("DOMContentLoaded", () => {
    AOS.init({
        duration: 1000,
        once: true
    });
});

    </script>
    <div class="bg-glass p-6 rounded-lg">

</body>
</html>
